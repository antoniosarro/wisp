# When the endpoint rejects a request as too long, old tool output is
# replaced by a stand-in naming the call, and the request is retried.

fakemodel model.yaml
exec wisp 'look around'
stdout 'done after trimming'
grep '\[read big.txt lines 1-60: .* masked; call read again' requests.jsonl
requests count 4
requests valid

-- model.yaml --
rules:
  - when: {role: user}
    reply: {tool_calls: [{name: read, args: {path: big.txt}}]}
  - when: {contains: big line}
    reply: {tool_calls: [{name: ls, args: {}}]}
  - when: {contains: big.txt}
    reply: {status: 400, error: "This model's maximum context length is 8192 tokens"}
  - when: {contains: big.txt}
    reply: {text: done after trimming}
-- big.txt --
